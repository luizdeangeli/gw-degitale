# Copie para .env e preencha. O .env não entra no git.
#   cp -n .env.example .env

# ─────────────────────────────────────────────
# Tokens que os sistemas usam para chamar o gateway.
# Formato: nome:segredo separados por vírgula.
# O log grava o nome, nunca o segredo.
# Gere um segredo:  openssl rand -hex 24
# ─────────────────────────────────────────────
GW_TOKENS=smg:troque-por-um-token,sig:troque-por-outro-token

# ─────────────────────────────────────────────
# Ordem da cadeia. 429, 5xx, timeout e credencial ruim
# seguem para o próximo. 404 encerra a consulta.
# cnpja sem CNPJA_API_KEY fica de fora da cadeia.
# receitaws sem RECEITAWS_TOKEN fica de fora da cadeia.
# apipj sem APIPJ_TOKEN fica de fora da cadeia.
# ─────────────────────────────────────────────
CNPJ_CHAIN=cnpjws,minhareceita,apipj,receitaws,cnpja
CEP_CHAIN=viacep,brasilapi

# ─────────────────────────────────────────────
# Provedores
# A chave do CNPJá não fica no código. Se ela ainda estiver
# no SMG (Externo/Cnpja.php), rotacione e coloque só aqui.
# ─────────────────────────────────────────────
CNPJA_BASE_URL=https://api.cnpja.com
CNPJA_API_KEY=
CNPJWS_BASE_URL=https://publica.cnpj.ws
MINHARECEITA_BASE_URL=https://minhareceita.org
RECEITAWS_BASE_URL=https://receitaws.com.br/v1
RECEITAWS_TOKEN=
RECEITAWS_DAYS=30
APIPJ_BASE_URL=https://apipj.com.br/v1
APIPJ_TOKEN=
VIACEP_BASE_URL=https://viacep.com.br
BRASILAPI_BASE_URL=https://brasilapi.com.br/api

# ─────────────────────────────────────────────
# Tempo de cada provedor e cache em memória
# ─────────────────────────────────────────────
HTTP_TIMEOUT=8s
CACHE_TTL_CNPJ=24h
CACHE_TTL_CEP=168h
PORT=8080
